#!/bin/sh
# Clean submodules the merge removed, then start the vendor refresh in the background.
# Pull returns at once.
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

if [ -x "$root/githooks/submodule-clean.sh" ]; then
  "$root/githooks/submodule-clean.sh" || true
fi

[ -x "$root/githooks/submodule-refresh.sh" ] || exit 0

log="${XDG_STATE_HOME:-$HOME/.local/state}/nixconfig/submodule-refresh.log"
mkdir -p "${log%/*}"

( "$root/githooks/submodule-refresh.sh" >>"$log" 2>&1 </dev/null & )
exit 0
