{
  "workflow": "none",
  "autoOpenBrowser": false,
  "commands": {
    "curator": { "enabled": false }
  },
  "crawl4aiBaseUrl": "http://127.0.0.1:11235",
  "crawl4aiApiToken": "$CRAWL4AI_API_TOKEN",
  "searxngBaseUrl": "http://127.0.0.1:8888",
  "fetch": {
    "allowedModes": ["readable", "raw"]
  },
  "fetchRouting": {
    "allowRemoteHostedProviders": true,
    "providers": [
      "crawl4ai",
      "http",
      "jina",
      "tinyfish",
      "search1api",
      "querit",
      "kagi",
      "ollama",
      "parallel",
      "brightdata",
      "gemini"
    ]
  },
  "ssrf": {
    "allowRanges": ["127.0.0.1/32"]
  }
}
