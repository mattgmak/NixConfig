{
  "mcpServers": {
    "Linear": {
      "url": "https://mcp.linear.app/mcp",
      "headers": {},
      "toolExposure": {
        "get_issue": "direct",
        "list_issues": "direct"
      }
    },
    "github-readonly": {
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_TOKEN}"
      }
    },
    "argent": {
      "command": "argent",
      "args": ["mcp"]
    },
    "manzanas": {
      "command": "manzanas",
      "args": ["mcp", "--daemon", "https://manzanas.dab-octatonic.ts.net"]
    },
    "nixos": {
      "command": "mcp-nixos",
      "args": []
    }
  }
}
