{
  "settings": {
    "oauthCredentialStore": "encrypted-file"
  },
  "mcpServers": {
    "Linear": {
      "url": "https://mcp.linear.app/mcp",
      "headers": {},
      "toolExposure": {
        "get_issue": "direct",
        "list_issues": "direct"
      }
    },
    "github-readonly": {
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_TOKEN}"
      },
      "toolExposure": {
        "pull_request_read": "direct",
        "get_file_contents": "direct",
        "search_code": "direct",
        "search_issues": "direct",
        "search_pull_requests": "direct",
        "issue_read": "direct",
        "list_commits": "direct",
        "get_commit": "direct",
        "list_branches": "direct",
        "list_pull_requests": "direct",
        "search_repositories": "direct"
      }
    },
    "argent": {
      "command": "argent",
      "args": ["mcp"]
    },
    "nixos": {
      "command": "nix",
      "args": ["run", "github:utensils/mcp-nixos/6a517811658c21f97bd7703b35546085117fc310", "--"],
      "toolExposure": {
        "nix": "direct",
        "nix_versions": "direct"
      }
    }
  }
}
