{
  "settings": {
    "oauthCredentialStore": "encrypted-file",
    "deferWithMissingMetadata": true
  },
  "mcpServers": {
    "Linear": {
      "url": "https://mcp.linear.app/mcp",
      "headers": {},
      "toolExposure": {
        "get_issue": "direct",
        "list_issues": "direct"
      }
    },
    "github-readonly": {
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_TOKEN}"
      }
    },
    "argent": {
      "command": "argent",
      "args": ["mcp"]
    },
    "nixos": {
      "command": "mcp-nixos",
      "args": []
    }
  }
}
