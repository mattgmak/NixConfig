{
  "compaction": "auto",
  "compactionEngine": "blackhole",
  "compactionSummaryMode": "default",
  "tailBehavior": "minimal",
  "midRunCompaction": "off",
  "skipForProviders": [],
  "compactAfterPreset": "optimized",
  "compactAfterPresets": {
    "optimized": [
      { "window": 32768, "ratio": 0.9 },
      { "window": 131072, "ratio": 0.8 },
      { "window": 262144, "ratio": 0.4 },
      { "window": 1048576, "ratio": 0.1 }
    ]
  },
  "retainedToolOutputMaxTokens": 20000,
  "observeAfterTokens": 15000,
  "reflectAfterTokens": 25000,
  "observationsPoolMaxTokens": 20000,
  "observationsPoolTargetTokens": 10000,
  "reflectorInputMaxTokens": 80000,
  "dropperInputMaxTokens": 80000,
  "dropperPressureThreshold": 0.7,
  "dropperPoolFullnessThreshold": 0.1,
  "observerChunkMaxTokens": 40000,
  "observerPreambleMaxTokens": 0,
  "agentMaxTurns": 16,
  "providerIdleTimeoutMs": 0,
  "memory": true,
  "sessionFallback": false,
  "fullFoldAlways": true,
  "debug": false,
  "debugLog": false,

  "model": {
    "_comment": "Base model (last fallback before the session model, which sessionFallback disables). OpenRouter free router: picks any eligible free endpoint, so it spreads load instead of hammering one queue.",
    "provider": "openrouter",
    "id": "openrouter/free",
    "thinking": "off",
    "cooldownHours": 2,
    "contextWindow": 200000
  },

  "observerModel": {
    "_comment": "Observer primary: Nemotron 3 Super 120B free. Fastest verified free endpoint (127-146ms), 262k window, valid structured tool call.",
    "provider": "openrouter",
    "id": "nvidia/nemotron-3-super-120b-a12b:free",
    "thinking": "low",
    "cooldownHours": 2,
    "contextWindow": 262144
  },
  "observerFallbackModels": [
    {
      "_comment": "Fallback 1: Nex N2.5 Mini free (401ms, 262k).",
      "provider": "openrouter",
      "id": "nex-agi/nex-n2.5-mini:free",
      "thinking": "low",
      "cooldownHours": 2,
      "contextWindow": 262144
    },
    {
      "_comment": "Fallback 2: Dots3 Note Preview free (1.0-1.3s, 512k window).",
      "provider": "openrouter",
      "id": "dots-studio/dots-3-note-preview:free",
      "thinking": "low",
      "cooldownHours": 2,
      "contextWindow": 512000
    },
    {
      "_comment": "Fallback 3: Nemotron 3 Nano Omni 30B free (393ms, 256k).",
      "provider": "openrouter",
      "id": "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free",
      "thinking": "low",
      "cooldownHours": 2,
      "contextWindow": 256000
    },
    {
      "_comment": "Fallback 4 (last resort): Ling 3.0 Flash Fin free. Finance-domain tune, worst fit for dev content, but historically the most reliably available free endpoint.",
      "provider": "openrouter",
      "id": "inclusionai/ling-3.0-flash-fin:free",
      "thinking": "low",
      "cooldownHours": 2,
      "contextWindow": 262144
