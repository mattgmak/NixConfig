{
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": true,
  "shellTools": {
    "ctx_shell": {
      "commandArgument": "command"
    }
  },
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "~/.config/lean-ctx/config.toml": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "xargs*": "deny",
      "env *": "deny",
      "time *": "deny",
      "nohup *": "deny",
      "timeout *": "deny",
      "nice *": "deny",
      "parallel *": "deny",
      "rust-parallel *": "deny",
      "rush *": "deny",
      "doas *": "deny",
      "setsid *": "deny",
      "stdbuf *": "deny",
      "watch *": "deny",
      "flock *": "deny",
      "find * -exec*": "deny",
      "find * -ok*": "deny",
      "fd * -x*": "deny",
      "fd * --exec*": "deny",
      "lean-ctx allow *": "deny",
      "lean-ctx allow": "deny",
      "lean-ctx config set shell_allowlist*": "deny",
      "lean-ctx config set shell_allowlist_extra*": "deny",
      "lean-ctx config set shell_security*": "deny",
      "lean-ctx security *": "deny",
      "lean-ctx harden undo*": "deny",
      "sudo *": "deny",
      "gh pr merge *": "deny",
      "gh pr close *": "deny",
      "gh api *pulls*merge*": "deny",
      "gh api *merges*": "deny"
    },
    "ctx_shell": {
      "*": "allow",
      "rm -rf *": "deny",
      "xargs*": "deny",
      "env *": "deny",
      "time *": "deny",
      "nohup *": "deny",
      "timeout *": "deny",
      "nice *": "deny",
      "parallel *": "deny",
      "rust-parallel *": "deny",
      "rush *": "deny",
      "doas *": "deny",
      "setsid *": "deny",
      "stdbuf *": "deny",
      "watch *": "deny",
      "flock *": "deny",
      "find * -exec*": "deny",
      "find * -ok*": "deny",
      "fd * -x*": "deny",
      "fd * --exec*": "deny",
      "lean-ctx allow *": "deny",
      "lean-ctx allow": "deny",
      "lean-ctx config set shell_allowlist*": "deny",
      "lean-ctx config set shell_allowlist_extra*": "deny",
      "lean-ctx config set shell_security*": "deny",
      "lean-ctx security *": "deny",
      "lean-ctx harden undo*": "deny",
      "sudo *": "deny",
      "gh pr merge *": "deny",
      "gh pr close *": "deny",
      "gh api *pulls*merge*": "deny",
      "gh api *merges*": "deny"
    },
    "external_directory": "allow"
  }
}