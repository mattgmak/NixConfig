{
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": true,
  "shellTools": {
    "ctx_shell": {
      "commandArgument": "command"
    },
    "ctx_bg": {
      "commandArgument": "command",
      "workdirArgument": "cwd"
    }
  },
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "~/.config/lean-ctx/config.toml": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "tmux kill-server*": {
        "action": "deny",
        "reason": "Kills the main tmux server and every agent pane in it. Kill one session with tmux kill-session -t <name>, or another server with tmux -S <socket> kill-server."
      },
      "tmux * kill-server*": "deny",
      "tmux -S * kill-server*": "allow",
      "tmux -S *default kill-server*": "deny",
      "tmux -L * kill-server*": "allow",
      "tmux -L default kill-server*": "deny",
      "xargs*": "deny",
      "env *": "deny",
      "time *": "deny",
      "nohup *": "deny",
      "timeout *": "deny",
      "nice *": "deny",
      "parallel *": "deny",
      "rust-parallel *": "deny",
      "rush *": "deny",
      "doas *": "deny",
      "setsid *": "deny",
      "stdbuf *": "deny",
      "watch *": "deny",
      "flock *": "deny",
      "find * -exec*": "deny",
      "find * -ok*": "deny",
      "fd * -x*": "deny",
      "fd * --exec*": "deny",
      "lean-ctx allow *": "deny",
      "lean-ctx allow": "deny",
      "lean-ctx config set shell_allowlist*": "deny",
      "lean-ctx config set shell_allowlist_extra*": "deny",
      "lean-ctx config set shell_security*": "deny",
      "lean-ctx security *": "deny",
      "lean-ctx harden undo*": "deny",
      "sudo *": "deny",
      "gh pr merge *": "deny",
      "gh pr close *": "deny",
      "gh api *pulls*merge*": "deny",
      "gh api *merges*": "deny",
      "find / *": "deny",
      "find /nix*": "deny",
      "find /System*": "deny",
      "find /Library*": "deny",
      "find /Applications*": "deny",
      "find /usr*": "deny",
      "find /private*": "deny",
      "find /var*": "deny",
      "find /Volumes*": "deny",
      "find ~ *": "deny",
      "find ~/ *": "deny",
      "find ~/Library*": "deny",
      "find ~/.cache*": "deny",
      "find ~/.local/state*": "deny",
      "find ~/.Trash*": "deny",
      "find /Users/mattgmak/Library*": "deny",
      "find /Users/mattgmak/.cache*": "deny",
      "find /Users/mattgmak/.local/state*": "deny",
      "find /Users/mattgmak/.Trash*": "deny",
      "fd * /": "deny",
      "fd * / *": "deny",
      "fd * /nix*": "deny",
      "fd * ~": "deny"
    },
    "ctx_shell": {
      "*": "allow",
      "rm -rf *": "deny",
      "tmux kill-server*": {
        "action": "deny",
        "reason": "Kills the main tmux server and every agent pane in it. Kill one session with tmux kill-session -t <name>, or another server with tmux -S <socket> kill-server."
      },
      "tmux * kill-server*": "deny",
